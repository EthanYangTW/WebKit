+// A context connection may only act on the workers it runs. Identifiers are global and sequential, so a
+// lookup by identifier alone would let one connection reach another site's workers.
+SWServerWorker* SWServerToContextConnection::ownedWorkerForIdentifier(ServiceWorkerIdentifier identifier)
+{
+    RefPtr worker = SWServerWorker::existingWorkerForIdentifier(identifier);
+    if (!worker || worker->contextConnection() != this || worker->topRegistrableDomain() != registrableDomain())
+        return nullptr;
+    return worker.get();
+}
